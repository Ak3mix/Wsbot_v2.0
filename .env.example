# Keyword Rules (JSON arrays)
WORK_KEYWORDS=[{"keywords":["hola","buenos"],"responses":["¡Hola! ¿En qué te ayudo?","Buenas"],"requireAllKeywords":false},{"keywords":["precio","costo"],"responses":["Los precios están en la web","Te paso el catálogo"]}]
PERSONAL_KEYWORDS=[{"keywords":["urgente","emergencia"],"responses":["Lo reviso ya","En un momento contesto"],"requireAllKeywords":false}]

# Server
